		sourceColumn: [DayName]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source = ```
				
				VAR minEng = MINX(Post_Engagement, Post_Engagement[post_date])
				VAR maxEng = MAXX(Post_Engagement, Post_Engagement[post_date])
				VAR minJob = MINX(postings, postings[listed_date])
				VAR maxJob = MAXX(postings, postings[listed_date])
				VAR minAll = MIN(minEng, minJob)
				VAR maxAll = MAX(maxEng, maxJob)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(minAll, maxAll),
				    "Year", YEAR([Date]),
				    "MonthNo", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "YearMonth", FORMAT([Date], "YYYY-MM"),
				    "DayName", FORMAT([Date], "DDD")
				)
				
				```

	annotation PBI_Id = e09cd7ea1baa4a9b9c13b6f7d1f63050

